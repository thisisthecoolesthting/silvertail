---
/**
 * SiteSectionAds — upgraded to central ad-injection system v3.
 * Old phone-case CaseAdSlot replaced; no more cad-composite.
 * inject.js fills these slots from ads.rickyscontrolcenter.com.
 */
import type { SectionPage } from '@/lib/section-page';
export type { SectionPage };
export interface Props {
  page: SectionPage;
  variant?: 'header' | 'footer' | 'both';
  compact?: boolean;
}
const { page, variant = 'both', compact = false } = Astro.props;
const showHeader = variant === 'header' || variant === 'both';
const showFooter = variant === 'footer' || variant === 'both';
---

{showHeader && (
  <div
    class:list={['max-w-site mx-auto px-4 sm:px-6 lg:px-8 not-prose', compact ? 'py-1' : 'py-2']}
    role='complementary'
    aria-label='Sponsored content'
  >
    <div data-ad-slot='in-article-mid' class='max-w-xs mx-auto'></div>
  </div>
)}

{showFooter && (
  <div class='max-w-site mx-auto px-4 sm:px-6 lg:px-8 py-6 border-t border-cream-200/80'>
    <div data-ad-slot='footer-family' class='max-w-3xl mx-auto'></div>
  </div>
)}
